---
export interface Props {
  size?: 'sm' | 'md' | 'lg' | 'full';
  class?: string;
}

const {
  size = 'lg',
  class: className = '',
} = Astro.props;

const sizeStyles = {
  sm: "max-w-4xl",
  md: "max-w-5xl",
  lg: "max-w-7xl",
  full: "max-w-[1400px]",
};
---

<div class:list={["mx-auto w-full px-4 sm:px-6 lg:px-8", sizeStyles[size], className]}>
  <slot />
</div>
