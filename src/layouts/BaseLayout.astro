---
import SEOHead from '../components/seo/SEOHead.astro';
import SchemaOrganization from '../components/seo/SchemaOrganization.astro';
import '@/styles/global.css';

export interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  author?: string;
}

const {
  title,
  description,
  image,
  canonicalUrl,
  type = 'website',
  publishedTime,
  author,
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR" class="dark scroll-smooth">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-LZJMZ2J9BK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-LZJMZ2J9BK');
    </script>
    <SEOHead
      title={title}
      description={description}
      image={image}
      canonicalUrl={canonicalUrl}
      type={type}
      publishedTime={publishedTime}
      author={author}
    />
    <SchemaOrganization />
    <slot name="schema" />
  </head>
  <body class="min-h-screen bg-background text-text-primary flex flex-col selection:bg-accent-violet/30 selection:text-white">
    <slot />
  </body>
</html>
